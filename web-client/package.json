{
  "name": "web-client",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "./node_modules/.bin/tsc -b && vite build",
    "build:prod": "VITE_API_URL=https://api.sudoduel.com VITE_WS_URL=wss://api.sudoduel.com vite build",
    "cap:ios": "npm run build:prod && ./node_modules/.bin/cap sync ios",
    "cap:ios:dev": "npm run build && ./node_modules/.bin/cap sync ios",
    "cap:android": "npm run build:prod && ./node_modules/.bin/cap sync android",
    "cap:android:dev": "npm run build && ./node_modules/.bin/cap sync android",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@awesome-cordova-plugins/in-app-purchase-2": "^8.1.0",
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "axios": "^1.13.2",
    "cordova-plugin-purchase": "^13.12.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "serve": "^14.2.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
